# Angular 22 + Nx 23 peer reconciliation.
#
# @nx/angular@23.0.1 declares its @angular/build / @angular-devkit/* / @schematics/angular
# peers with a "< 22.0.0" ceiling (it formally supports Angular up to 21). The locked stack
# (PROJECT.md) is Angular 22.x + Nx 23.x -- the only pairing that supports TypeScript 6 -- so
# the Angular-22 framework + tooling packages legitimately exceed @nx/angular@23.0.1's optional
# peer ranges. legacy-peer-deps lets npm install the locked Angular-22 tree against the
# Nx-23 plugin without aborting on that known, accepted peer-range mismatch.
#
# Revisit when @nx/angular ships a stable release whose peers admit Angular 22 (the 23.1.x line).
legacy-peer-deps=true
