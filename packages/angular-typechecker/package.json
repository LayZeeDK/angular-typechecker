{
  "name": "angular-typechecker",
  "version": "0.2.3",
  "description": "Nx executor that runs the complete Angular compiler type-check (TypeScript + template type-check + extended NG8xxx diagnostics), no emit, decoupled from build and test.",
  "keywords": [
    "nx",
    "nx-plugin",
    "angular",
    "typecheck",
    "type-check",
    "ngc",
    "compiler-cli",
    "diagnostics"
  ],
  "author": "Lars Gyrup Brink Nielsen <larsbrinknielsen@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/LayZeeDK/angular-typechecker#readme",
  "bugs": {
    "url": "https://github.com/LayZeeDK/angular-typechecker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayZeeDK/angular-typechecker.git",
    "directory": "packages/angular-typechecker"
  },
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "executors": "./executors.json",
  "generators": "./generators.json",
  "builders": "./builders.json",
  "schematics": "./collection.json",
  "bin": {
    "angular-typechecker": "./src/cli/bin.js",
    "atc": "./src/cli/bin.js"
  },
  "ng-add": {
    "save": "devDependencies"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "executors.json",
    "generators.json",
    "builders.json",
    "collection.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@nx/devkit": "23.0.1",
    "node-sarif-builder": "^4.1.0",
    "nx": "^23.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/compiler-cli": "^22.0.0",
    "typescript": ">=6.0.0 <6.1.0",
    "@angular-devkit/architect": ">=0.2200.0 <0.2300.0",
    "@angular-devkit/schematics": "^22.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "peerDependenciesMeta": {
    "@angular-devkit/architect": {
      "optional": true
    },
    "@angular-devkit/schematics": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
