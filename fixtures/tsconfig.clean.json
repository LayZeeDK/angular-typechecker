  // run `nx typecheck @angular-typechecker/source --tsConfig=<leaf> --skip-nx-cache`
  // and keep it here only if the verdict is GREEN (an advisory "not type checked"
  // notice counts as GREEN). Reference concrete LEAF tsconfigs only -- never a nested
  // solution-style tsconfig.
