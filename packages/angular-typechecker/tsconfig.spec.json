{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    // The solution tsconfig pins `module`/`moduleResolution` to `nodenext` for the
    // CommonJS-shipped lib (the Nx executor loader is `require()`-based). The specs
    // do NOT ship: they run under Vitest/Vite (esbuild), which uses bundler module
    // resolution and permits `import.meta` + extensionless relative/dynamic imports.
    // Type-check them under the mode that matches their real runtime so the check
    // reflects execution semantics instead of the lib's shipping constraints.
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "exclude": ["src/**/*.drift.ts"]
}
