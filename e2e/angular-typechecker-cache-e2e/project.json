{
  "name": "angular-typechecker-cache-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e/angular-typechecker-cache-e2e/src",
  "tags": ["scope:fixture", "type:e2e"],
  "implicitDependencies": [
    "angular-typechecker",
    "typecheck-consumer",
    "typecheck-consumer-dep"
  ],
  "targets": {
    "e2e": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/e2e/angular-typechecker-cache-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "externalDependencies": [
            "typescript",
            "vitest",
            "@nx/vite",
            "@nx/devkit"
          ]
        }
      ],
      "options": {
        "command": "tsc --noEmit -p e2e/angular-typechecker-cache-e2e/tsconfig.spec.json",
        "cwd": "."
      }
    }
  }
}
