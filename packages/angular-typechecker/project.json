{
  "name": "angular-typechecker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular-typechecker/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/angular-typechecker",
        "main": "packages/angular-typechecker/src/index.ts",
        "tsConfig": "packages/angular-typechecker/tsconfig.lib.json",
        "assets": [
          "packages/angular-typechecker/*.md",
          {
            "input": "./packages/angular-typechecker/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/angular-typechecker/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/angular-typechecker",
            "glob": "executors.json",
            "output": "."
          },
          {
            "input": "./packages/angular-typechecker",
            "glob": "LICENSE",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck-drift": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/core/compiler-cli-types.drift.ts",
        "{projectRoot}/src/core/compiler-cli-types.ts",
        "{projectRoot}/tsconfig.drift.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/node_modules/@angular/compiler-cli/index.d.ts",
        "{workspaceRoot}/node_modules/@angular/compiler-cli/src/transformers/api.d.ts"
      ],
      "options": {
        "command": "tsc --noEmit -p packages/angular-typechecker/tsconfig.drift.json",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["build"],
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/packages/angular-typechecker"
      }
    }
  }
}
