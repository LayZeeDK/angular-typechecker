{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": false,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "lib": ["es2022", "dom"],
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["main.ts", "../../aggregated-ui/**/*.ts"]
}
